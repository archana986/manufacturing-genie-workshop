  "instructions": {
    "text_instructions": [
      {
        "id": "ddf2744241654a308c3133e60f0936d2",
        "content": [
          "Prefer MEASURE() on metric views. OEE is a 0 to 1 ratio of sums. Never average daily OEE percentages. FPY is good_units / units. Scrap rate is a ratio, never a date."
        ]
      }
    ],
    "example_question_sqls": [
      {
        "id": "9c2153ea7b7340d5aea40c53232d5b95",
        "question": ["What is overall OEE?"],
        "sql": ["SELECT MEASURE(`oee`) AS oee FROM YOUR_CATALOG.YOUR_SCHEMA.mv_line_performance"]
      }
    ]
  },
  "data_sources": {
